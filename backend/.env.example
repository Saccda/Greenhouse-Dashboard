# InfluxDB Cloud
INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=your_org_id_here
INFLUXDB_BUCKET=IoT_Project

# PostgreSQL (local storage)
POSTGRES_URL=postgresql://user:password@localhost:5432/greenhouse

# Node-RED (for relay control)
NODE_RED_URL=http://localhost:1880

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_secret_key
FLASK_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app

# Session cookie scope. Leave unset for local dev (cookie defaults to the
# exact host that set it, which works fine across localhost ports). In
# production, set to ".yourdomain.com" (leading dot) so the cookie is shared
# between the API subdomain and the frontend's own subdomain — this is what
# lets the frontend's Next.js middleware see session presence. Only works
# if frontend and backend share a parent domain; leave unset otherwise.
COOKIE_DOMAIN=

# Timezone
TIMEZONE=Asia/Phnom_Penh
