# Secrets — never commit real credentials
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Python
__pycache__/
*.pyc
.venv/
backend/.venv/
backend/data/*.db
backend/data/users.json
backend/data/setpoints.json
backend/data/settings.json
# The dry-run pump lockout latch. Machine-local runtime state, like the files
# above, and worse than useless shared: a lockout committed here would travel
# to another machine and tell it a farm is locked out when it is not, or hide
# that one is. It is written by services/pump_guard.py and belongs only to the
# backend that wrote it.
backend/data/pump_guard.json
backend/data/service-out.log
backend/data/service-err.log

# Node / Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/

# OS cruft
.DS_Store
Thumbs.db

# ML model artifacts — built on the lab desktop from the Postgres archive
# (scripts/train_forecast.py). Machine-local and data-derived; never committed.
backend/models/

# CAD sources — large binaries git cannot diff. Keep the optimised .glb in
# public/models/ and store the STEP/SLDASM originals outside the repo.
*.step
*.stp
*.STEP
*.STP
*.sldprt
*.sldasm

# Raw CAD exports dropped into public/ — tens of MB and they would ship on
# every deploy. Only the optimised model in public/models/ is committed.
frontend/public/*.glb
!frontend/public/models/*.glb

# Raw photo and video originals dropped into public/ for the same reason: the
# 48 MB sitting there are camera originals whose web versions are already
# committed under public/campus/ (made by scripts/optimize-media.ps1), and only
# those are referenced by the app. One .MOV alone is 35 MB, and committing it
# would put it in every clone and every deploy forever. Keep originals outside
# the repo. Only files directly in public/ match -- subfolders such as
# public/campus/ and public/farm/ hold the optimised copies and are untouched,
# as are the assets already tracked here.
frontend/public/*.jpg
frontend/public/*.JPG
frontend/public/*.jpeg
frontend/public/*.mp4
frontend/public/*.MOV
frontend/public/*.mov
frontend/public/*.png

# Scratch copies of artifacts, written at the repo root by mistake
/scratchpad_*.html

# TypeScript incremental build cache — regenerated by every build and 280 KB of
# churn per commit.
frontend/tsconfig.tsbuildinfo

# Local dev server log — noise, and it can contain request details
backend/data/*.log
